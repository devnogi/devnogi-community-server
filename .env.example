# Synthetic local defaults only. Copy to .env.local; never use in production.
DB_HOST=mysql
DB_PORT=3306
DB_SCHEMA=devnogi
DB_USER=devnogi
DB_PASSWORD=local-only-password
DB_ROOT_PASSWORD=local-only-root-password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
MINIO_URL=http://minio:9000
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=local-bucket
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP_ID=devnogi-community-local
JWT_SECRET_KEY=local-development-only-key-change-before-any-shared-use
JWT_ACCESS_TOKEN_VALIDITY=3600
JWT_REFRESH_TOKEN_VALIDITY=86400
